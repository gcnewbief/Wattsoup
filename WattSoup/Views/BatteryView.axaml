<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WattSoup.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="560"
             x:Class="WattSoup.Views.BatteryView"
             x:DataType="vm:BatteryViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="{Binding ModelName}" FontSize="18" FontWeight="SemiBold" Foreground="#F5F7FA" />
            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#8A93A2" />
        </StackPanel>

        <!-- Main gauge area -->
        <!-- TODO(agent): replace this simple percentage + ProgressBar with a proper circular
             progress ring (Arc / PathGeometry). See TASKS.md task UI-1. -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <TextBlock Text="{Binding Percentage, StringFormat='{}{0}%'}"
                       FontSize="72" FontWeight="Bold"
                       Foreground="{Binding PercentageBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Status}" FontSize="16"
                       Foreground="#C7CDD6" HorizontalAlignment="Center" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percentage}"
                         Width="260" Height="8" Foreground="{Binding PercentageBrush}" Background="#1E222B" />
        </StackPanel>

        <!-- Metrics grid -->
        <Border Grid.Row="2" Background="#161A21" CornerRadius="12" Padding="20">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,8,16">
                    <TextBlock Text="TIME REMAINING" FontSize="10" Foreground="#6B7280" />
                    <TextBlock Text="{Binding TimeRemaining}" FontSize="16" Foreground="#F5F7FA" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="8,0,0,16">
                    <TextBlock Text="HEALTH / WEAR" FontSize="10" Foreground="#6B7280" />
                    <TextBlock Text="{Binding Health}" FontSize="16" Foreground="{Binding HealthBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,0,8,16">
                    <TextBlock Text="FULL CHARGE CAPACITY" FontSize="10" Foreground="#6B7280" />
                    <TextBlock Text="{Binding FullChargeCapacity}" FontSize="16" Foreground="#F5F7FA" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="8,0,0,16">
                    <TextBlock Text="DESIGN CAPACITY" FontSize="10" Foreground="#6B7280" />
                    <TextBlock Text="{Binding DesignCapacity}" FontSize="16" Foreground="#F5F7FA" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2" Margin="0,0,8,16">
                    <TextBlock Text="CYCLE COUNT" FontSize="10" Foreground="#6B7280" />
                    <TextBlock Text="{Binding CycleCount}" FontSize="16" Foreground="#F5F7FA" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2" Margin="8,0,0,16">
                    <TextBlock Text="VOLTAGE" FontSize="10" Foreground="#6B7280" />
                    <TextBlock Text="{Binding Voltage}" FontSize="16" Foreground="#F5F7FA" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Spacing="2" Margin="0,0,8,16">
                    <TextBlock Text="POWER" FontSize="10" Foreground="#6B7280" />
                    <TextBlock Text="{Binding Power}" FontSize="16" Foreground="{Binding PowerBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2" Margin="8,0,0,16">
                    <TextBlock Text="MANUFACTURE DATE" FontSize="10" Foreground="#6B7280" />
                    <TextBlock Text="{Binding ManufactureDate}" FontSize="16" Foreground="#F5F7FA" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                    <TextBlock Text="SERIAL NUMBER" FontSize="10" Foreground="#6B7280" />
                    <TextBlock Text="{Binding SerialNumber}" FontSize="16" Foreground="#F5F7FA" />
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
