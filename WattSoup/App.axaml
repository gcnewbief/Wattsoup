<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WattSoup.App"
             xmlns:local="using:WattSoup"
             RequestedThemeVariant="Dark">
    <!-- "Default" ThemeVariant follows the OS theme; we force Dark for the dashboard look. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
